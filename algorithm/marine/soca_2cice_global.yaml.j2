input geometry:
  mom6_input_nml: mom_input.nml
  fields metadata: fields_metadata.yaml

output geometry:
  mom6_input_nml: mom_input.nml
  fields metadata: fields_metadata.yaml

variable change:
  variable change name: Soca2Cice
  arctic:
    seaice edge: 0.4
    shuffle: true
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
  antarctic:
    seaice edge: 0.4
    shuffle: true
    rescale prior:
      rescale: true
      min hice: 0.5
      min hsno: 0.1
  cice background state:
    restart: ./Data/{{ marine_window_middle_fv3 }}'.cice_model.res.nc'
    ncat: 5
    ice_lev: 7
    sno_lev: 1
  cice output:
    restart: ./Data/{{ marine_window_middle_fv3 }}'.cice_model.res.nc'
  increment output:
    datadir: Data
    exp: soca2cice
    type: incr
    {% if marine_do_iau %}
    date: {{ marine_window_begin_iso }}
    {% else %}
    date: {{ marine_window_middle_iso }}
    {% endif %}
  soca increment:
    read_from_file: 1
    basename: ./
    ocn_filename: ./Data/ocn.3dvarfgat_pseudo.incr.{{ marine_window_middle_iso }}.nc
    ice_filename: ./Data/ice.3dvarfgat_pseudo.incr.{{ marine_window_middle_iso }}.nc
    {% if marine_do_iau %}
    date: {{ marine_window_begin_iso }}
    {% else %}
    date: {{ marine_window_middle_iso }}
    {% endif %}
  output variables:
  - sea_water_potential_temperature
  - sea_water_salinity
  - sea_ice_area_fraction
  - sea_ice_thickness
  - sea_ice_snow_thickness

states:
- input:
     read_from_file: 1
     basename: ./
     ocn_filename: ./Data/ocn.3dvarfgat_pseudo.an.{{ marine_window_middle_iso }}.nc
     ice_filename: ./Data/ice.3dvarfgat_pseudo.an.{{ marine_window_middle_iso }}.nc
     {% if marine_do_iau %}
     date: {{ marine_window_begin_iso }}
     {% else %}
     date: {{ marine_window_middle_iso }}
     {% endif %}
     state variables:
     - sea_water_potential_temperature
     - sea_water_salinity
     - sea_ice_area_fraction
     - sea_ice_thickness
     - sea_ice_snow_thickness

  output:
     datadir: Data
     exp: soca2cice
     type: fc
     {% if marine_do_iau %}
     date: {{ marine_window_begin_iso }}
     {% else %}
     date: {{ marine_window_middle_iso }}
     {% endif %}
