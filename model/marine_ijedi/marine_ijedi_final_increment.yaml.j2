output:
  date: '{{ marine_ijedi_window_begin }}'
  io:
    filetype: mom6
    datapath: {{ marine_ijedi_final_increment_dir }}
    ocn_file: {{ marine_ijedi_final_increment_exp }}.incr.nc
    field io names:
      sea_water_potential_temperature: Temp
      sea_water_salinity: Salt
      sea_surface_height_above_geoid: ave_ssh
geometry:
  geometry_type: mom6
  ocean_hgrid: {{ marine_ijedi_ocean_hgrid }}
  ocean_topog: {{ marine_ijedi_ocean_topog }}
  vertical geometry from: {{ marine_ijedi_vertical_geometry_from }}
  coarsen factor: {{ marine_ijedi_coarsen_factor | default(1) }}
  has northern fold: {{ marine_ijedi_has_northern_fold | default(true) }}
  MOM_input:
    NIGLOBAL: {{ marine_ijedi_niglobal }}
    NJGLOBAL: {{ marine_ijedi_njglobal }}
    NZ: {{ marine_ijedi_nz }}
    LAYOUT: {{ marine_ijedi_layout }}
    MINIMUM_DEPTH: {{ marine_ijedi_minimum_depth | default(0.5) }}
