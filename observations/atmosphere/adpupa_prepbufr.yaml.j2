      error parameter: 5.6
    where:
    - variable:
        name: TempObsErrorData/virtualTemperature
      minvalue: 5.6
    - variable:
        name: TempObsErrorData/virtualTemperature
      is_defined:
    defer to post: true

# Ignore this test, just use the QualityMarker check below
